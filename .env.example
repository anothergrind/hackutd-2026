# Everything is optional. With nothing set, the app runs on in-memory demo data in scripted mode.

# Supabase (persists runs). Run supabase/migrations 001-005 in order in the SQL editor.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (no NEXT_PUBLIC_ prefix). Supabase > Project Settings > API keys > service_role / secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Live Nemotron. build.nvidia.com > any Nemotron model > "Get API Key". Without it the crew runs scripted.
NVIDIA_API_KEY=nvapi-...
# Optional: pick from `npm run smoke` output
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Site password. Set both before deploying: every page and API call then asks for them (browser login prompt).
# Leave unset for local dev. The cron route is exempt; it checks CRON_SECRET instead.
# SITE_PASSWORD=pick-a-long-random-string
# SITE_USER=opscrew

# Optional knobs
# OPSCREW_MODE=scripted        # force scripted mode even with a key (e.g. flaky Wi-Fi on stage)
# OPSCREW_FALLBACK=false       # by default an agent falls back to scripted if Nemotron errors before it drafts anything
# OPSCREW_PACE_MS=1200         # pause between scripted turns so the live view is followable
# ALLOW_DEMO_RESET=true        # enables the Reset demo button against Supabase
# CRON_SECRET=...              # Vercel Cron sends this to /api/sweep/cron (schedule in vercel.json)
