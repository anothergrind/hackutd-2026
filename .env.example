NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (no NEXT_PUBLIC_ prefix). Supabase > Project Settings > API keys > service_role / secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# build.nvidia.com > any Nemotron model > "Get API Key"
NVIDIA_API_KEY=nvapi-...
# Optional: pick from `npm run smoke` output
NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
